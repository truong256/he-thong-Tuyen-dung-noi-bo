# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recruitment_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT configuration
JWT_SECRET=change_me_to_a_long_random_secret

# Server ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# SMTP Configuration (Google App Password / SMTP Relay)
# Required when running with SPRING_PROFILES_ACTIVE=dev,smtp
SPRING_PROFILES_ACTIVE=dev,smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=
MAIL_FROM=
APP_FRONTEND_URL=http://localhost:5173
VITE_IDLE_TIMEOUT_MS=300000
