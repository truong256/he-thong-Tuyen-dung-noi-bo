# Configure values privately in your backend provider. Do not commit the filled file.
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
APP_FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
# Mount persistent storage at /data for existing avatar/company image uploads.
APP_UPLOAD_AVATAR_DIR=/data/uploads/avatars
APP_UPLOAD_COMPANY_DIR=/data/uploads/company
# No automatic demo seeding during ordinary server startup.
DEMO_SEED_ENABLED=false
# Optional SMTP: only claim email delivery after testing a real mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
