NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Cơ sở dữ liệu PostgreSQL (khớp docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=recruit
DB_PASSWORD=recruit
DB_NAME=recruitment
DB_SSL=false
# Luôn để false; dùng `npm run migration:run` để tạo bảng.
DB_SYNCHRONIZE=false

# JWT (production bắt buộc >= 32 ký tự ngẫu nhiên)
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRES_IN_SECONDS=900

# Đăng nhập giả lập theo vai trò để demo. TUYỆT ĐỐI để false ở staging/production.
AUTH_DEV_LOGIN=true
