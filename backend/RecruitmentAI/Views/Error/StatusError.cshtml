@model RecruitmentAI.Models.ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
    var isNotFound = Model.StatusCode == "404";
}

<link rel="stylesheet" href="~/css/error.css" />

<div class="error-wrapper">
    <div class="error-card">

        <div class="error-icon">
            @if (isNotFound)
            {
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                    <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M8 11H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            }
            else
            {
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 9V13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M12 16.5V16.51" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M10.29 3.86L1.82 18A2 2 0 0 0 3.55 21H20.45A2 2 0 0 0 22.18 18L13.71 3.86A2 2 0 0 0 10.29 3.86Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
            }
        </div>

        <div class="error-code">@Model.StatusCode</div>
        <h1 class="error-title">@Model.Title</h1>
        <p class="error-message">@Model.Message</p>
        @if (!string.IsNullOrEmpty(Model.Hint))
        {
            <p class="error-hint">@Model.Hint</p>
        }

        <div class="error-actions">
            <button type="button" class="btn btn-outline-secondary btn-error-action" onclick="goBack()">
                <span aria-hidden="true">←</span> Quay lại
            </button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-error-action">
                Về trang chủ
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">Mã yêu cầu: @Model.RequestId</p>
        }
    </div>
</div>

<script>
    function goBack() {
        if (document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
            window.history.back();
        } else {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    }
</script>